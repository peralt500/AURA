# Supabase (Públicas)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Servidor / Rol de servicio - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Servidor - opcional para newsletters masivos y avisos)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notificaciones@tu-dominio.com

# URL del sitio para enlaces de confirmación y redirecciones
NEXT_PUBLIC_SITE_URL=http://localhost:3000
